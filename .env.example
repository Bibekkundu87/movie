# ==========================================
# STREAMBOX CONFIGURATION
# ==========================================
# Copy this file to .env.local and fill in your values.

# ---- FRONTEND MODE ----
# Mock Mode: Set to "true" to test with built-in sample videos.
# Set to "false" to connect to the live Google Drive backend.
NEXT_PUBLIC_USE_MOCK_DATA="true"

# ---- GOOGLE DRIVE CONFIGURATION ----
# Required when NEXT_PUBLIC_USE_MOCK_DATA is "false".

# Google Drive Target Folder ID: The single source of truth containing all video files.
# Videos uploaded, deleted, or renamed in this folder are discovered automatically.
GOOGLE_DRIVE_FOLDER_ID="your_google_drive_folder_id_here"

# Google Service Account Credentials (NEVER EXPOSE TO CLIENT)
GOOGLE_CLIENT_EMAIL="streambox-sa@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT_HERE\n-----END PRIVATE KEY-----\n"

# ---- BACKEND TUNING ----
# Metadata cache time-to-live in milliseconds (default: 15000 = 15 seconds).
METADATA_CACHE_TTL_MS=15000
